package com.astra.assistant.voice

import android.media.AudioDeviceInfo
import android.media.AudioFormat
import android.media.AudioRecord
import android.media.MediaRecorder
import android.os.Build
import android.os.Handler
import android.os.Looper
import android.util.Log
import org.json.JSONObject
import org.vosk.LibVosk
import org.vosk.LogLevel
import org.vosk.Model
import org.vosk.Recognizer

// Offline speech recognition. One microphone session runs until it is stopped, so there are
// no restarts and no start sounds. All callbacks arrive on the main thread.
class OfflineRecognizer(
    private val onPartial: (String) -> Unit,
    private val onFinal: (String) -> Unit,
    private val onFailure: (String) -> Unit,
    private val onInput: (String) -> Unit,
    private val onCaptureStarted: () -> Unit
) {
    private val main = Handler(Looper.getMainLooper())
    private val lock = Any()
    private var model: Model? = null
    private var recognizer: Recognizer? = null
    private var loadedPath: String? = null
    private var loading = false
    private var thread: Thread? = null
    private var preferred: AudioDeviceInfo? = null

    @Volatile private var wantCapture = false
    @Volatile private var running = false
    @Volatile private var muted = false
    @Volatile private var needReset = false

    val isRunning: Boolean
        get() = running

    fun start(path: String, preferredDevice: AudioDeviceInfo?) {
        wantCapture = true
        preferred = preferredDevice
        if (running && loadedPath == path) return
        if (running) stopCapture()
        wantCapture = true
        synchronized(lock) {
            if (loadedPath != null && loadedPath != path) freeModel()
            if (model == null) {
                if (!loading) {
                    loading = true
                    Thread({ load(path) }, "astra-vosk-load").start()
                }
                return
            }
        }
        beginCapture()
    }

    private fun load(path: String) {
        try {
            LibVosk.setLogLevel(LogLevel.WARNINGS)
            val m = Model(path)
            val r = Recognizer(m, SAMPLE_RATE.toFloat())
            synchronized(lock) {
                model = m
                recognizer = r
                loadedPath = path
                loading = false
            }
            main.post { if (wantCapture) beginCapture() }
        } catch (t: Throwable) {
            Log.e(TAG, "Could not load the offline speech model", t)
            synchronized(lock) { loading = false }
            main.post { onFailure("The offline voice engine could not start (${t.javaClass.simpleName}).") }
        }
    }

    private fun beginCapture() {
        synchronized(lock) {
            if (running || thread?.isAlive == true) return
            val rec = recognizer ?: return
            val minBuf = AudioRecord.getMinBufferSize(
                SAMPLE_RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT
            )
            if (minBuf <= 0) {
                main.post { onFailure("This phone did not accept the microphone settings.") }
                return
            }
            val record: AudioRecord? = try {
                AudioRecord(
                    MediaRecorder.AudioSource.VOICE_RECOGNITION,
                    SAMPLE_RATE,
                    AudioFormat.CHANNEL_IN_MONO,
                    AudioFormat.ENCODING_PCM_16BIT,
                    maxOf(minBuf * 2, 8192)
                )
            } catch (e: Exception) {
                null
            }
            if (record == null || record.state != AudioRecord.STATE_INITIALIZED) {
                record?.release()
                main.post { onFailure("Could not open the microphone.") }
                return
            }
            preferred?.let { record.setPreferredDevice(it) }
            try {
                record.startRecording()
            } catch (e: Exception) {
                record.release()
                main.post { onFailure("The microphone could not start.") }
                return
            }
            running = true
            needReset = true
            val t = Thread({ loop(rec, record) }, "astra-vosk-capture")
            thread = t
            t.start()
        }
    }

    private fun loop(rec: Recognizer, record: AudioRecord) {
        val buffer = ShortArray(4000)
        var lastPartial = ""
        var reported = false
        try {
            while (running) {
                val n = record.read(buffer, 0, buffer.size)
                if (n < 0) {
                    main.post { onFailure("The microphone stopped delivering audio.") }
                    break
                }
                if (n == 0) continue
                if (!reported) {
                    reported = true
                    val label = describe(record.routedDevice)
                    main.post {
                        onCaptureStarted()
                        onInput(label)
                    }
                }
                if (muted) continue
                if (needReset) {
                    needReset = false
                    rec.reset()
                    lastPartial = ""
                }
                if (rec.acceptWaveForm(buffer, n)) {
                    val text = field(rec.result, "text")
                    lastPartial = ""
                    if (text.isNotBlank()) main.post { onFinal(text) }
                } else {
                    val partial = field(rec.partialResult, "partial")
                    if (partial != lastPartial) {
                        lastPartial = partial
                        if (partial.isNotBlank()) main.post { onPartial(partial) }
                    }
                }
            }
        } catch (t: Throwable) {
            Log.e(TAG, "Offline capture failed", t)
            main.post { onFailure("The offline voice engine stopped (${t.javaClass.simpleName}).") }
        } finally {
            try {
                record.stop()
            } catch (e: Exception) {
                Log.w(TAG, "record.stop failed", e)
            }
            record.release()
            running = false
        }
    }

    private fun field(json: String, key: String): String =
        try {
            JSONObject(json).optString(key, "").trim()
        } catch (e: Exception) {
            ""
        }

    // The real input Android selected, for example the earbuds or the phone microphone.
    private fun describe(device: AudioDeviceInfo?): String {
        if (device == null) return "Phone microphone"
        val name = device.productName?.toString().orEmpty()
        val type = device.type
        return when {
            type == AudioDeviceInfo.TYPE_BUILTIN_MIC -> "Phone microphone"
            type == AudioDeviceInfo.TYPE_BLUETOOTH_SCO -> "Bluetooth: " + name.ifBlank { "earbuds" }
            Build.VERSION.SDK_INT >= 31 && type == AudioDeviceInfo.TYPE_BLE_HEADSET ->
                "Bluetooth: " + name.ifBlank { "earbuds" }
            type == AudioDeviceInfo.TYPE_WIRED_HEADSET || type == AudioDeviceInfo.TYPE_USB_HEADSET -> "Wired headset"
            else -> name.ifBlank { "Other microphone" }
        }
    }

    // While muted the microphone stays on, but the audio is thrown away (used while ASTRA speaks).
    fun setMuted(value: Boolean) {
        muted = value
        if (!value) needReset = true
    }

    // Releases the microphone but keeps the speech model loaded for a quick restart.
    fun stopCapture() {
        wantCapture = false
        running = false
        val t = thread
        if (t != null && t.isAlive) {
            try {
                t.join(1500)
            } catch (e: InterruptedException) {
                Log.w(TAG, "interrupted while stopping", e)
            }
        }
        if (t == null || !t.isAlive) thread = null
    }

    fun restartCapture(preferredDevice: AudioDeviceInfo?) {
        val path = loadedPath ?: return
        stopCapture()
        start(path, preferredDevice)
    }

    fun release() {
        stopCapture()
        synchronized(lock) { freeModel() }
    }

    private fun freeModel() {
        try {
            recognizer?.close()
        } catch (e: Exception) {
            Log.w(TAG, "recognizer.close failed", e)
        }
        try {
            model?.close()
        } catch (e: Exception) {
            Log.w(TAG, "model.close failed", e)
        }
        recognizer = null
        model = null
        loadedPath = null
    }

    companion object {
        private const val TAG = "ASTRA_OFFLINE"
        private const val SAMPLE_RATE = 16000
    }
}
